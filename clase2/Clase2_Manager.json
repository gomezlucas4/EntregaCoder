        "operation": "sendAndWait",
        "chatId": "1486091356",
        "message": "=🚨 APROBACIÓN REQUERIDA\n\nSolicitud: {{ $('Datos del mensaje').first().json.original_input }}\n\nÁrea: {{ $('Normalizar contrato Router').first().json.intent }}\nConfianza: {{ Math.round($('Normalizar contrato Router').first().json.confidence * 100) }}%\nRiesgo: {{ $('Normalizar contrato Router').first().json.risk }}\n\nLa solicitud necesita revisión humana. ¿Autorizás continuar?",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "id": "a68354d8-186e-48f7-ae4a-be023d6a581d",
      "name": "Aprobacion humana",

    {
      "parameters": {
        "jsCode": "const aprobado = $json.data?.approved === true;\nreturn [{ json: {\n  status: aprobado ? 'approved_by_human' : 'rejected_by_human',\n  worker: 'HITL',\n  respuesta: aprobado\n    ? 'Un responsable revisó tu solicitud y la va a gestionar. Te vamos a contactar.'\n    : 'Un responsable revisó tu solicitud y no puede resolverse de forma automática. Te vamos a contactar.',\n  requires_human: true\n} }];"
      },
      "id": "c0b2d9b6-89aa-464c-93ac-b929db2c07c8",
      "name": "Resultado HITL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({ json: {\n  timestamp: new Date().toISOString(),\n  status: item.json.status ?? 'success',\n  worker: item.json.worker ?? 'N/D',\n  respuesta: item.json.respuesta ?? '',\n  requires_human: Boolean(item.json.requires_human)\n} }));"
      },

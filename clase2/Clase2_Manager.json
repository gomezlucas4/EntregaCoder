        }
      },
      "id": "b959de47-6b70-4135-ba29-9a3e1c3aaa74",
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        432,
        208
      ],

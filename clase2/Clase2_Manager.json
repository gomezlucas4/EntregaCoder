        "jsCode": "const p = $('Normalizar contrato Router').first().json;\nreturn $input.all().map(item => ({ json: {\n  ...item.json,\n  chat_id: p.chat_id,\n  intent: p.intent,\n  confidence: p.confidence,\n  risk: p.risk,\n  payload_enviado: JSON.stringify({\n    original_input: p.original_input,\n    chat_id: p.chat_id,\n    nombre_telegram: p.nombre_telegram,\n    intent: p.intent,\n    confidence: p.confidence,\n    risk: p.risk\n  }),\n  log: `${item.json.timestamp} | worker=${item.json.worker} | status=${item.json.status} | HITL=${item.json.requires_human}`\n} }));"
      },

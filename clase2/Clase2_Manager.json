    {
      "parameters": {
        "jsCode": "const entrada = $('Datos del mensaje').first().json;\nconst raw = $json.text ?? $json.output ?? $json.response ?? '';\nlet d;\ntry {\n  d = JSON.parse(String(raw).replace(/```json|```/gi, '').trim());\n} catch (e) {\n  d = { intent: 'UNKNOWN', confidence: 0, risk: 'HIGH' };\n}\nconst allowed = ['PEDIDO', 'RECLAMO', 'CUENTAS', 'UNKNOWN'];\nconst intent = allowed.includes(d.intent) ? d.intent : 'UNKNOWN';\nconst confidence = Math.max(0, Math.min(1, Number(d.confidence ?? 0)));\nconst risk = ['LOW', 'MEDIUM', 'HIGH'].includes(d.risk) ? d.risk : 'HIGH';\nreturn [{ json: {\n  original_input: entrada.original_input,\n  chat_id: entrada.chat_id,\n  nombre_telegram: entrada.nombre_telegram,\n  intent, confidence, risk\n} }];"
      },
